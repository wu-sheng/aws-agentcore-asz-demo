# ---------------------------------------------------------------------------
# asz observability wiring — the FOUR langsmith env vars.
#
# These point the langsmith tracing client (bundled in langchain-core) at asz's
# langsmith-ingest receiver instead of LangSmith cloud. asz impersonates the
# LangSmith ingest API, so NO LangSmith account is needed.
#
# Tier-1 (local): point at the local asz on 127.0.0.1:8787.
# Tier-2 (AWS):   point at the asz endpoint the AgentCore microVM can reach
#                 (ALB DNS or VPC-private address) — NOT localhost.
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=http://127.0.0.1:8787
LANGCHAIN_API_KEY=asz-local-dev            # any non-empty value; asz does not verify
LANGCHAIN_PROJECT=langgraph-agentcore-asz-demo

# ---------------------------------------------------------------------------
# Model provider (optional).
# Leave BEDROCK_MODEL_ID unset for the credential-free stub (Tier-1).
# Set it to a Bedrock model id (and have AWS creds) to use real inference.
# ---------------------------------------------------------------------------
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-east-1
