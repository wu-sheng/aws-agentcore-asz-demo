# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# ALL deploy-specific values are here — nothing is hardcoded in the .tf files.

aws_region  = "us-east-1"      # must support Bedrock AgentCore
aws_profile = "default"        # your local AWS CLI profile
project_name = "aws-agentcore-asz-demo"

# asz collector image (confirm the real published coordinates)
asz_image = "apache/skywalking-ai-sessionizer:latest"
asz_port  = 8787

# networking — the AgentCore microVM MUST be able to reach the asz endpoint.
# For a throwaway public-ALB PoC, narrow asz_ingress_cidrs to your IP + AgentCore
# egress. For a VPC-private design, set asz_alb_internal = true and keep ingress
# to the VPC CIDR.
asz_alb_internal  = false
asz_ingress_cidrs = ["0.0.0.0/0"] # TODO: narrow this — do not leave open

agent_ecr_repo_name = "langgraph-agentcore-asz-agent"

tags = {
  Owner = "wu-sheng"
}
