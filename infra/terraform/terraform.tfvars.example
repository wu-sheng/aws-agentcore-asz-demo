# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# ALL deploy-specific values are here — nothing is hardcoded in the .tf files.

aws_region = "us-east-1" # must offer Bedrock AgentCore Runtime
# aws_profile = "my-profile"   # omit to use the SDK's default credential chain

project_name = "aws-agentcore-asz-demo"

# REQUIRED: who may open the asz UI. Your public IP: curl -s https://checkip.amazonaws.com
asz_ui_cidrs = ["203.0.113.7/32"]

# The agent's model. Amazon Nova Pro works in any account with no extra step.
# Claude models need the account's one-time Anthropic use-case form (Bedrock
# console, Model access), and AWS does not serve every newer Claude model to
# every account; scripts/up.sh calls the model once before it builds anything
# and stops if the account cannot use it. Empty = the scripted stand-in model
# (no Bedrock cost). BEDROCK_MODEL_ID overrides this for one run, e.g.
#   BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1 ./scripts/up.sh
bedrock_model_id = "us.amazon.nova-pro-v1:0"

# Only if apply fails on the agent runtime's subnets: pin AZs AgentCore supports.
# availability_zone_ids = ["use1-az1", "use1-az2"]

# Set by scripts/up.sh after it pushes the image; leave empty here.
# agent_image_tag = ""

tags = {
  Owner = "wu-sheng"
}
